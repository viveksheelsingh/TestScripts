      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "defaultValue": "zonal-drill-01",
      "metadata": {
        "description": "Name of the Drill. Pattern: letters, numbers, hyphens only, 3-24 chars."
      }
    },
    "drillRegion": {
      "type": "string",
      "defaultValue": "westcentralus",
      "metadata": {
        "description": "Region where the Drill's internal (Chaos/monitoring) resources are created. Must match an allowed region; hardcoded here like the IRM resource group."
      }
    },
    "drillApiVersion": {
      "type": "string",
      "defaultValue": "2026-06-01-preview",
      "metadata": {
        "description": "Latest apiVersion for drills as of this session. A Recovery Plan must already exist on the Service Group before the Drill can succeed (confirmed via live test - drill goes to provisioningState Failed otherwise). drillAssetProperties.resourceGroup MUST be set to an existing, tag-policy-compliant resource group (e.g. 'IRM') - if omitted, the RP tries to auto-create its own default RG 'AzureResilienceManagementDrills' which this tenant's '[BCDR]: Enforce Resource Group Tags' policy blocks (RHDSUserErrorInsufficientPermission/RequestDisallowedByPolicy)."
      }
    }
  },
