  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "southcentralus"
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    },
    "serviceGroupName": {
      "type": "string",
      "defaultValue": "CaldovaPayApp_Ex4_Task1_SG"
    },
    "serviceGroupDisplayName": {
      "type": "string",
      "defaultValue": "[parameters('serviceGroupName')]"
    },
    "serviceGroupParentId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional parent Service Group resource ID. Leave empty for a root-level Service Group (defaults to the tenant-root Service Group)."
      }
    },
    "healthModelName": {
      "type": "string",
      "defaultValue": "ahm-ex4-task1",
      "metadata": {
        "description": "Azure Health Model (Microsoft.CloudHealth/healthmodels) created against this Service Group. step2's Drill references this via healthModelMonitoringProperties.healthModelId."
      }
    },
    "sharedResourceGroupName": {
      "type": "string",
      "defaultValue": "CaldovaPayApp_Ex3_Task3",
      "metadata": {
        "description": "Resource group containing the shared Ex3_Task3 infrastructure; not the deployment resource group."
      }
    }
  },
  "variables": {
    "serviceGroupResourceId": "[format('/providers/Microsoft.Management/serviceGroups/{0}', parameters('serviceGroupName'))]",
    "serviceGroupRelationshipId": "[format('default{0}', parameters('serviceGroupName'))]",
    "vnetNameValue": "[format('vnet-{0}', uniqueString(variables('sharedResourceGroupId')))]",
    "publicIpNameValue": "[format('pubip-{0}', uniqueString(variables('sharedResourceGroupId')))]",
    "lbNameValue": "[format('web-lb-{0}', uniqueString(variables('sharedResourceGroupId')))]",
    "webVm1NameValue": "[format('web-vm-1-{0}', uniqueString(variables('sharedResourceGroupId')))]",
    "webVm2NameValue": "[format('web-vm-2-{0}', uniqueString(variables('sharedResourceGroupId')))]",
    "appVm1NameValue": "[format('app-vm-1-{0}', uniqueString(variables('sharedResourceGroupId')))]",
    "appVm2NameValue": "[format('app-vm-2-{0}', uniqueString(variables('sharedResourceGroupId')))]",
    "pgServerNameValue": "[format('pg-flex-{0}', uniqueString(variables('sharedResourceGroupId')))]",
    "storageNameValue": "[format('st{0}', uniqueString(variables('sharedResourceGroupId')))]",
    "healthModelNameValue": "[parameters('healthModelName')]",
    "sharedResourceGroupId": "[format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Management/serviceGroups",
      "apiVersion": "2024-02-01-preview",
      "scope": "/",
      "name": "[parameters('serviceGroupName')]",
      "properties": "[createObject('displayName', parameters('serviceGroupDisplayName'), 'parent', createObject('resourceId', if(empty(parameters('serviceGroupParentId')), format('/providers/Microsoft.Management/serviceGroups/{0}', tenant().tenantId), parameters('serviceGroupParentId'))))]"
    },
    {
      "type": "Microsoft.CloudHealth/healthmodels",
      "apiVersion": "2026-05-01-preview",
      "name": "[variables('healthModelNameValue')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": "[parameters('tags')]",
      "properties": {}
    },
    {
      "type": "Microsoft.CloudHealth/healthmodels/authenticationsettings",
      "apiVersion": "2026-05-01-preview",
      "name": "[format('{0}/default-auth', variables('healthModelNameValue'))]",
      "properties": {
        "displayName": "Default Authentication",
        "authenticationKind": "ManagedIdentity",
        "managedIdentityName": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CloudHealth/healthmodels', variables('healthModelNameValue'))]"
      ]
    },
    {
      "type": "Microsoft.CloudHealth/healthmodels/discoveryrules",
      "apiVersion": "2026-05-01-preview",
      "name": "[format('{0}/{1}', variables('healthModelNameValue'), variables('healthModelNameValue'))]",
      "properties": {
        "displayName": "Discover Service Group Resources",
        "authenticationSetting": "default-auth",
        "discoverRelationships": "Enabled",
        "addRecommendedSignals": "Enabled",
        "addResourceHealthSignal": "Enabled",
        "specification": {
          "kind": "ResourceGraphQuery",
          "resourceGraphQuery": "[format('relationshipresources | where type =~ ''microsoft.relationships/servicegroupmember'' | where tostring(properties.TargetId) =~ ''{0}'' | project id=tostring(properties.SourceId) | union (resourcecontainers | where id =~ ''{0}'' | project id)', variables('serviceGroupResourceId'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CloudHealth/healthmodels', variables('healthModelNameValue'))]",
        "[resourceId('Microsoft.CloudHealth/healthmodels/authenticationsettings', variables('healthModelNameValue'), 'default-auth')]"
      ]
    }
  ],
  "outputs": {
    "serviceGroupId": {
      "type": "string",
      "value": "[tenantResourceId('Microsoft.Management/serviceGroups', parameters('serviceGroupName'))]"
    },
    "healthModelId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CloudHealth/healthmodels', variables('healthModelNameValue'))]"
    },
    "healthModelName": {
      "type": "string",
      "value": "[variables('healthModelNameValue')]"
    },
    "vnetId": {
      "type": "string",
      "value": "[resourceId(subscription().subscriptionId, parameters('sharedResourceGroupName'), 'Microsoft.Network/virtualNetworks', format('vnet-{0}', uniqueString(variables('sharedResourceGroupId'))))]"
    },
    "publicIpId": {
      "type": "string",
      "value": "[resourceId(subscription().subscriptionId, parameters('sharedResourceGroupName'), 'Microsoft.Network/publicIPAddresses', format('pubip-{0}', uniqueString(variables('sharedResourceGroupId'))))]"
    },
    "loadBalancerId": {
      "type": "string",
      "value": "[resourceId(subscription().subscriptionId, parameters('sharedResourceGroupName'), 'Microsoft.Network/loadBalancers', format('web-lb-{0}', uniqueString(variables('sharedResourceGroupId'))))]"
    },
    "webVm1Id": {
      "type": "string",
      "value": "[resourceId(subscription().subscriptionId, parameters('sharedResourceGroupName'), 'Microsoft.Compute/virtualMachines', format('web-vm-1-{0}', uniqueString(variables('sharedResourceGroupId'))))]"
    },
    "webVm2Id": {
      "type": "string",
      "value": "[resourceId(subscription().subscriptionId, parameters('sharedResourceGroupName'), 'Microsoft.Compute/virtualMachines', format('web-vm-2-{0}', uniqueString(variables('sharedResourceGroupId'))))]"
    },
    "appVm1Id": {
      "type": "string",
      "value": "[resourceId(subscription().subscriptionId, parameters('sharedResourceGroupName'), 'Microsoft.Compute/virtualMachines', format('app-vm-1-{0}', uniqueString(variables('sharedResourceGroupId'))))]"
    },
    "appVm2Id": {
      "type": "string",
      "value": "[resourceId(subscription().subscriptionId, parameters('sharedResourceGroupName'), 'Microsoft.Compute/virtualMachines', format('app-vm-2-{0}', uniqueString(variables('sharedResourceGroupId'))))]"
    },
    "postgresId": {
      "type": "string",
      "value": "[resourceId(subscription().subscriptionId, parameters('sharedResourceGroupName'), 'Microsoft.DBforPostgreSQL/flexibleServers', format('pg-flex-{0}', uniqueString(variables('sharedResourceGroupId'))))]"
    },
    "storageId": {
      "type": "string",
      "value": "[resourceId(subscription().subscriptionId, parameters('sharedResourceGroupName'), 'Microsoft.Storage/storageAccounts', format('st{0}', uniqueString(variables('sharedResourceGroupId'))))]"
    },
    "healthModelPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CloudHealth/healthmodels', parameters('healthModelName')), '2026-05-01-preview', 'full').identity.principalId]"
    }
  }
}
